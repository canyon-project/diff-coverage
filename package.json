{
  "name": "@canyonjs/diff-coverage",
  "type": "module",
  "version": "0.0.10",
  "description": "Simple change statement coverage report component.",
  "author": "Author Name <author.name@mail.com>",
  "license": "MIT",
  "homepage": "https://github.com/canyon-project/diff-coverage#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canyon-project/diff-coverage.git"
  },
  "bugs": {
    "url": "https://github.com/canyon-project/diff-coverage/issues"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "play": "vite",
    "test": "vitest",
